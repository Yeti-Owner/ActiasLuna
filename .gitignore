# Docs: keep only READMEs
*.md
!README.md

# 3D scans / meshes
mesh/
*.glb
*.gltf
*.obj
*.fbx
*.stl
*.ply
*.usdz
*.zip

# Secrets (regenerate with tools/gen_secrets.py)
config/network.json
config/certs/
firmware/luna_node/main/luna_secrets.h
*.pem
*.key
.env

# Personal data: recordings, calibration, device MACs
data/*
# ...except the imported room scan, so the 3D view and decoys work on a fresh clone (no MACs or recordings in it).
!data/scan/
data/scan/*
!data/scan/room.json
!data/scan/scan.glb

# ESP-IDF build output
firmware/**/build*/
firmware/**/sdkconfig
firmware/**/sdkconfig.old
firmware/**/managed_components/
firmware/**/dependencies.lock

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Logs, backups, scratch
*.log
*.bak
*.tmp
*.out

# Editors / OS
.vscode/
.idea/
.claude/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Frontend (web/): deps and build output
node_modules/
web/static/
config/cloud.json
