# chert\setup.ps1 copies this to .env.local (never committed) and fills AGENT_NAME and the MOTH_* lines from
# config\cloud.json. You only paste a voice key below.

# Voice brain: Gemini if GOOGLE_API_KEY is set (free key at aistudio.google.com/apikey), else OpenAI Realtime.
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Leave all three empty to run calls in Chert's LiveKit (Shared plan). Otherwise all three from one cloud.livekit.io project.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# A name no other team uses. chert dev and chert doctor read it from .env.local.
AGENT_NAME=actias-room

# Room history on Vultr (cloud/deploy.sh prints these). The QUERY token can only read.
MOTH_API_URL=https://YOUR-VULTR-IP-WITH-DASHES.sslip.io
MOTH_QUERY_TOKEN=paste-the-QUERY-token-here
MOTH_ROOM=demo-room
MOTH_TZ=America/New_York
